generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Anonymous visitors get a row here the first time they open the app.
model User {
  id            String         @id @default(uuid()) @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at")
  videos        UserVideo[]
  conversations Conversation[]

  @@map("users")
}

enum VideoStatus {
  processing
  ready
  failed

  @@map("video_status")
}

// A video is a shared entity: it is ingested and embedded once,
// then linked to any number of users.
model Video {
  id            String              @id @default(uuid()) @db.Uuid
  youtubeId     String              @unique @map("youtube_id")
  title         String
  channel       String?
  thumbnailUrl  String              @map("thumbnail_url")
  status        VideoStatus         @default(processing)
  errorMessage  String?             @map("error_message")
  chunkCount    Int?                @map("chunk_count")
  createdAt     DateTime            @default(now()) @map("created_at")
  users         UserVideo[]
  conversations ConversationVideo[]

  @@map("videos")
}

// A user's library: which videos they have added.
model UserVideo {
  userId  String   @map("user_id") @db.Uuid
  videoId String   @map("video_id") @db.Uuid
  addedAt DateTime @default(now()) @map("added_at")
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video   Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@map("user_videos")
}

model Conversation {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  title     String              @default("New chat")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos    ConversationVideo[]
  messages  Message[]

  @@map("conversations")
}

// Which videos a conversation can search (max 5, enforced in the API).
model ConversationVideo {
  conversationId String       @map("conversation_id") @db.Uuid
  videoId        String       @map("video_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  video          Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([conversationId, videoId])
  @@map("conversation_videos")
}

enum MessageRole {
  user
  assistant

  @@map("message_role")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  role           MessageRole
  content        String
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}
