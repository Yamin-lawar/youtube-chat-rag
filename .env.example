# Copy to .env and fill in. Never commit .env.

# Server
PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# Postgres (matches docker-compose.yml).
# If port 5432 is taken by another Postgres on your machine, set POSTGRES_PORT=5433
# and use 5433 in DATABASE_URL as well.
# POSTGRES_PORT=5432
DATABASE_URL=postgres://ytchat:ytchat@localhost:5432/ytchat

# Qdrant (matches docker-compose.yml).
# If ports 6333 and 6334 are taken by another Qdrant on your machine, set QDRANT_PORT and
# QDRANT_GRPC_PORT (for example 6335 and 6336) and use that port in QDRANT_URL as well.
# QDRANT_PORT=6333
# QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# Gemini API key from https://aistudio.google.com (free tier)
GOOGLE_API_KEY=

# How chunks are found for a question: dense (default) or hybrid (experiment in progress)
# SEARCH_STRATEGY=dense
# Hybrid only: how much the exact-word list counts next to the meaning list (1). Lower = trust meaning more.
# HYBRID_SPARSE_WEIGHT=1
# Re-order the search results with a local model (downloaded on first use, no API key):
# none (default), minilm (about 90 MB, 0.25 s per question, English) or bge-m3 (about 570 MB, 4 s, multilingual)
# RERANKER=none

# Groq is tried first for answers and for rewriting follow-up questions, with Gemini as the fallback
# (free key from https://console.groq.com)
GROQ_API_KEY=
